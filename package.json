{
  "name": "ai-zip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "worker:test": "node --experimental-strip-types --test worker/src/notion.test.ts worker/src/collect.test.ts worker/src/staging.test.ts",
    "worker:db:local": "wrangler d1 execute ai-zip-staging --local --file=worker/schema.sql",
    "worker:db:remote": "wrangler d1 execute ai-zip-staging --remote --file=worker/schema.sql",
    "seed:sql": "node --experimental-strip-types scripts/seed-to-d1.ts",
    "enrich": "node --experimental-strip-types scripts/enrich-all.ts",
    "push:notion": "node --experimental-strip-types --env-file=.env.local scripts/push-to-notion.ts",
    "enrich:notion": "node --experimental-strip-types --env-file-if-exists=worker/.dev.vars --env-file-if-exists=.env.local scripts/agent/enricher.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.3",
    "hono": "^4.12.32",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
